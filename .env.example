# Скопируйте этот файл в .env и подставьте свои значения
PORT=3000

# Секрет для подписи JWT — обязательно смените на длинную случайную строку в проде
JWT_SECRET=change-me-to-a-long-random-string

# "production" включает secure-cookie (требует HTTPS)
NODE_ENV=development

# Публичный адрес сайта — используется в ссылке сброса пароля и для og:url.
# Если не задан, берётся из заголовков запроса (обычно ок, но за реверс-прокси/CDN
# может быть ненадёжно — тогда пропишите явно, например https://vivorose.com).
PUBLIC_URL=http://localhost:3000

# SMTP для писем восстановления пароля. Без этих переменных письмо не уходит —
# ссылка на сброс просто печатается в консоль сервера (годится для разработки,
# но не для реальных пользователей). Используем Gmail (app-password, требует
# включённой двухфакторки на аккаунте) — вместо него подойдёт и любой другой
# провайдер/сервис вроде Yandex, SendGrid, Mailgun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vivorosesupport@gmail.com
SMTP_PASS=
SMTP_FROM=vivorosesupport@gmail.com

# Куда раз в сутки уходит автоматический бэкап базы (server/backup.js) —
# вложением, через тот же SMTP выше. Необязательна: если не задать, письма
# идут на vivorosesupport@gmail.com (тот же адрес, что и SMTP_USER/SMTP_FROM —
# отправка самому себе, никакой отдельной настройки не требует).
BACKUP_EMAIL_TO=vivorosesupport@gmail.com

# Пароль для входа в /admin (панель администратора: трафик, ошибки от
# пользователей, рубильник сайта). Без этой переменной панель не пустит никого.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Client ID из Google Cloud Console (OAuth-клиент типа "Web application") —
# включает кнопку "Войти через Google" на страницах входа/регистрации. Без
# этой переменной кнопка просто не показывается (не выглядит нерабочей —
# её нет вообще), обычная форма email/пароль работает как и раньше.
# Как получить: console.cloud.google.com → создать/выбрать проект → APIs &
# Services → Credentials → Create Credentials → OAuth client ID → Web
# application. В "Authorized JavaScript origins" добавьте оба адреса, откуда
# реально открывают сайт: https://vivorose.com (прод) и http://localhost:3000
# (разработка) — без этого Google отклонит запрос кнопки с "origin not
# allowed". Секрет клиента (Client Secret) не нужен — только сам Client ID,
# он не секретный (виден в каждом запросе кнопки).
GOOGLE_CLIENT_ID=
