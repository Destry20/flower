<?xml version="1.0" encoding="UTF-8"?>
<!-- Замените https://example.com на реальный домен перед запуском в продакшен.
     Страницы конструктора/открыток используют hash-роутинг (#mine, #premium…),
     который поисковики не индексируют как отдельные URL, поэтому в карте сайта
     достаточно перечислить только настоящие серверные адреса. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://example.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
